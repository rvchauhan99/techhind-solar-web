# Required: Backend API base URL. Never leave empty.
# All API calls use this base URL - e.g. purchase-orders, auth, suppliers.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9090/api

# Optional: for multi-tenant API only; tenant key (slug from registry, e.g. acme) sent on login.
# NEXT_PUBLIC_TENANT_KEY=acme

# Optional: Admin Tenant Management UI. Same backend; requests use this key (x-admin-api-key / Bearer).
# NEXT_PUBLIC_ADMIN_API_KEY=

# WhatsApp Connect uses backend OAuth (same pattern as Meta Lead Ads).
# Do NOT set NEXT_PUBLIC_WA_* — configure on the API instead:
#   WHATSAPP_APP_ID / WHATSAPP_APP_SECRET
#   WHATSAPP_CONFIG_ID     ← Create configuration with System User (never-expire), NOT 60-day template
#   WHATSAPP_REDIRECT_URI  ← https://solar-api-demo-d8tfk.ondigitalocean.app/api/whatsapp-setup/oauth/callback
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN
#   WHATSAPP_AGENT_ENABLED=true
#   CORS_ALLOWED_ORIGINS must include https://demo.techhind.in (and other tenant hosts)
#
# Each tenant SuperAdmin connects their own WABA at /whatsapp-setup
